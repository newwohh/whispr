# Server Configuration
PORT=8000
HOST=0.0.0.0
SECRET_KEY=REDACTED_CONFIGURE_LOCALLY

# Relational Database (SQLite)
SQLITE_PATH=./db.sqlite3

# MongoDB (Messages & Chats)
MONGODB_URI=REDACTED_CONFIGURE_LOCALLY
MONGODB_DB_NAME=whispr

# Redis (Optional Channel Layer for Multi-node clustering)
REDIS_URL=REDACTED_CONFIGURE_LOCALLY
USE_IN_MEMORY_CHANNEL_LAYER=true
